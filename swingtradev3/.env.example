# Zerodha Kite (Paid - ₹500/mo)
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://localhost:5000

# NVIDIA NIM (Free tier)
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# News & Data
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
UPSTOX_ACCESS_TOKEN=
# Optional ticker -> Upstox instrument key map for broker news, e.g.
# {"RELIANCE":"NSE_EQ|INE002A01018","TCS":"NSE_EQ|INE467B01029"}
UPSTOX_INSTRUMENT_KEYS_JSON=

# Fallback LLMs
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Local llama.cpp OpenAI-compatible server running on the Linux host/GPU.
# Containers reach the host through host.docker.internal, which is wired in docker-compose.dev.yml.
LOCAL_LLM_ENABLED=false
LLAMA_CPP_PROVIDER=llama_cpp
LLAMA_CPP_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLAMA_CPP_BASE_URL=http://host.docker.internal:8080/v1
LLAMA_CPP_HEALTH_URL=http://host.docker.internal:8080/health
LLAMA_CPP_API_KEY=not-needed
LLAMA_CPP_TIMEOUT_SECONDS=30
LLAMA_CPP_MAX_RETRIES=1
LLAMA_CPP_MAX_TOKENS=1200
LLAMA_CPP_STRUCTURED_OUTPUT=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MCP
KITE_MCP_URL=http://kite-mcp:3000
TOOLBOX_ENABLED=true
TOOLBOX_URL=http://toolbox:5000

# FastAPI
FASTAPI_API_KEY=

# Postgres
POSTGRES_DB=swingtradev3
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/swingtradev3

# Memgraph
MEMGRAPH_URI=bolt://memgraph:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
MEMGRAPH_DATABASE=memgraph

# Runtime guardrails
LIVE_TRADING_ENABLED=false
NEW_ENTRIES_ENABLED=false
EXIT_ONLY_MODE=false
USE_SLOW_BRAIN=false
USE_EXCEPTION_ANALYST=false

# Manual operator attestations
KITE_DDPI_POA_CONFIRMED=false
